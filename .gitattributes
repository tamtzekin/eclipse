# ECLIPSE — Git LFS rules (cross-platform Mac/PC)
* text=auto eol=lf

# Source code (text)
*.cpp    text
*.h      text
*.hpp    text
*.cs     text
*.ini    text
*.csv    text
*.json   text
*.md     text
*.txt    text
*.uproject text

# UE binary assets — track via Git LFS
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.upk    filter=lfs diff=lfs merge=lfs -text

# Articy:draft export package — binary; LFS-track so reimports don't bloat
# the repo. The .articyue is the source of truth; importer regenerates the
# .uasset databases + Source/eclipse/ArticyGenerated/*.h from it.
*.articyue filter=lfs diff=lfs merge=lfs -text

# Audio / textures / video
*.mp3    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.ogg    filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.tga    filter=lfs diff=lfs merge=lfs -text
*.psd    filter=lfs diff=lfs merge=lfs -text
*.exr    filter=lfs diff=lfs merge=lfs -text
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.obj    filter=lfs diff=lfs merge=lfs -text
*.mp4    filter=lfs diff=lfs merge=lfs -text
*.mov    filter=lfs diff=lfs merge=lfs -text

# Force LF on UE config / source — avoids CRLF noise across Win/Mac
*.cs    text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.ini   text eol=lf

# Inkpot plugin's bundled inklecate compiler binaries (Mac/Linux/Windows) —
# 60MB+ each on Mac/Linux, extensionless on Mac/Linux so not caught by an
# extension-based rule above; LFS-track the whole ThirdParty tree so any
# future binary drops here are covered too.
Plugins/Inkpot/ThirdParty/** filter=lfs diff=lfs merge=lfs -text

# Mark ArticyXImporter-regenerated outputs as "generated" so GitHub
# collapses them in PR review (they're noisy on schema changes). These
# files ARE committed (so teammates don't have to reimport after every
# pull) but aren't worth line-by-line review.
Source/eclipse/ArticyGenerated/**         linguist-generated=true
Content/Dialogues/ArticyContent/Generated/** linguist-generated=true
